{
  "name": "gh-projects-mcp",
  "version": "1.9.0",
  "description": "MCP server for managing GitHub Projects v2 (fields, items, views, sub-issues, status updates) across any repo/owner",
  "type": "module",
  "bin": {
    "gh-projects-mcp": "./server.mjs",
    "gh-projects-mcp-http": "./server-http.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "start:http": "node server-http.mjs",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint .",
    "contract:check": "node scripts/tool-contract.mjs check",
    "contract:write": "node scripts/tool-contract.mjs write",
    "contract:verify": "node scripts/tool-contract.mjs verify",
    "package:verify": "node scripts/client-package-contract.mjs",
    "docs:tools": "node scripts/render-tool-inventory.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright": "^1.59.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0"
  },
  "engines": {
    "node": ">=18"
  }
}
